#!/usr/bin/env zsh

emulate -L zsh
setopt pipefail extendedglob

# Keep this autoload interface while containing helper definitions and state.
(

# Usage: API_KEY=<key> opencode_update_provider_models [OPTIONS] <PROVIDER_NAME> <API_ENDPOINT> [CONFIG_FILE]
#
# Options:
#	-v, --verbose	Enable detailed step-by-step logging.
#	-h, --help		Show this help message and exit.
#
# Arguments:
#	PROVIDER_NAME	Human-readable provider name (converted to snake_case for the key).
#	API_ENDPOINT	OpenAI-compatible API endpoint.
#	CONFIG_FILE		opencode config file path (default: opencode.json).
#
# Environment variables:
#	API_KEY			API key for authentication (required).
#
# Behavior:
#	Fetches models from the provider endpoint and updates the configuration file.
#	Uses `<endpoint>/models` for inventory and enriched metadata, supplemented by
#	LiteLLM `/model/info`. Maps prices, tiers, limits and reasoning to native V2.
#	Embeddings are excluded; image models stay disabled until explicitly configured
#	with an image runtime. Responses models use the native Responses runtime.
#
#	Each successful refresh replaces metadata using only the current responses.
#	Missing/null metadata is omitted, including previously edited metadata.
#	Request settings, custom names and package overrides are preserved. Reasoning
#	effort variants are retained only when confirmed by current metadata.
#	Models absent from the inventory are removed. No companion files are needed.
#	Migrates this provider's legacy settings to native V2, preserving native overrides.
#	If the config file doesn't exist, it will be created.
#
# Exit codes:
#	0	Success
#	nonzero	Error (validation, fetch, transformation, or filesystem failure)
#
# Examples:
#	API_KEY=sk-xxx opencode_update_provider_models "OpenAI Compatible" https://api.example.com opencode.json
#	API_KEY=sk-xxx opencode_update_provider_models --verbose "OpenAI Compatible" https://api.example.com

# ── Help ────────────────────────────────────────────────────────────
local -r SCRIPT_NAME=${0:t}

print_usage() {
	print -ru2 -- "Usage: API_KEY=<key> $SCRIPT_NAME [OPTIONS] <PROVIDER_NAME> <API_ENDPOINT> [CONFIG_FILE]"
	print -ru2 -- ""
	print -ru2 -- "Options:"
	print -ru2 -- "  -v, --verbose   Enable detailed step-by-step logging"
	print -ru2 -- "  -h, --help      Show this help message and exit"
	print -ru2 -- ""
	print -ru2 -- "Arguments:"
	print -ru2 -- "  PROVIDER_NAME   Human-readable provider name (converted to snake_case)"
	print -ru2 -- "  API_ENDPOINT    OpenAI-compatible API endpoint (must use https://)"
	print -ru2 -- "  CONFIG_FILE     Config file path (default: opencode.json)"
	print -ru2 -- ""
	print -ru2 -- "Environment:"
	print -ru2 -- "  API_KEY         API key for authentication (required)"
}

# ── Option parsing ──────────────────────────────────────────────────
integer verbose=0

while (( $# > 0 )) && [[ $1 == -* ]]; do
	case $1 in
		-v|--verbose) verbose=1; shift ;;
		-h|--help) print_usage; return 0 ;;
		--) shift; break ;;
		-*) print -ru2 -- "Error: unknown option: $1"; print_usage; return 1 ;;
	esac
done

# ── Verbose logging helper ──────────────────────────────────────────
vlog() {
	(( verbose )) && print -ru2 -- "[VERBOSE] $*" || :
}

# ── Dependencies ────────────────────────────────────────────────────
local cmd
for cmd (curl jq); do
	if (( ! $+commands[$cmd] )); then
		print -ru2 -- "Error: $cmd is required but not installed"
		return 1
	fi
	vlog "Dependency check: $cmd found"
done

# ── Argument validation ─────────────────────────────────────────────
if (( $# < 2 || $# > 3 )); then
	print -ru2 -- "Error: expected 2-3 arguments, got $#"
	print_usage
	return 1
fi

local provider_name=$1 api_endpoint=$2 config_file=${3:-opencode.json}
api_endpoint=${api_endpoint%/}

if [[ -z $provider_name ]]; then
	print -ru2 -- "Error: PROVIDER_NAME cannot be empty"
	return 1
fi

if [[ -z $api_endpoint ]]; then
	print -ru2 -- "Error: API_ENDPOINT cannot be empty"
	return 1
fi

if [[ $api_endpoint != https://* ]]; then
	print -ru2 -- "Error: API_ENDPOINT must start with https://"
	return 1
fi

if [[ -z ${API_KEY:-} ]]; then
	print -ru2 -- "Error: API_KEY environment variable is required"
	return 1
fi

vlog "Config: provider='$provider_name' endpoint='$api_endpoint' file='$config_file'"

# ── Fetch a single route into a file, printing the HTTP status code ─
fetch_route() {  # url out key
	vlog "HTTP request: $1"
	local http_code
	http_code=$(curl -sL -o "$2" -w '%{http_code}' \
		--max-time 10 --connect-timeout 3 \
		-H "Authorization: Bearer $3" \
		-H "Content-Type: application/json" \
		"$1") || return $?
	vlog "HTTP response: $http_code"
	print -- "$http_code"
}

# ── jq definitions ──────────────────────────────────────────────────

# Turn a raw model id into a human-friendly display name
local JQ_FORMAT_NAME='
def format_name:
	gsub("[/_]"; "-")
	# Protect param sizes: 3-27b -> 3 27b (space, not dot)
	| gsub("(?<d1>[0-9])-(?<d2>[0-9]+b)"; "\(.d1) \(.d2)")
	# Merge remaining version digits: 3-3 -> 3.3
	| gsub("(?<d1>[0-9])-(?<d2>[0-9])"; "\(.d1).\(.d2)")
	| split("-")
	| map((.[0:1] | ascii_upcase) + (.[1:] | ascii_downcase))
	| join(" ")
	# Uppercase known acronyms
	| gsub("(?<pre>^| )Gpt(?<post> |$)"; "\(.pre)GPT\(.post)")
	| gsub("(?<pre>^| )Oss(?<post> |$)"; "\(.pre)OSS\(.post)")
	| gsub("(?<pre>^| )It(?<post> |$)"; "\(.pre)IT\(.post)")
	# Lowercase version prefix
	| gsub("(?<pre>^| )V(?<version>[0-9.]+)(?<post> |$)"; "\(.pre)v\(.version)\(.post)")
	# Uppercase parameter sizes (7b -> 7B, 120b -> 120B)
	| gsub("(?<pre>^| )(?<num>[0-9.]+)b(?<post> |$)"; "\(.pre)\(.num)B\(.post)");
'

# Transform the current discovery snapshot to OpenCode V2. Missing/null values
# are unknown, not false or zero. Only identity and request customizations carry
# over; historical metadata (including manual edits) is discarded.
local JQ_TRANSFORM_MODELS='
def number:
	(if type == "string" then tonumber else . end)
	| if type != "number" then error("Expected numeric metadata")
	  elif (isnan or isinfinite or . < 0) then error("Invalid numeric metadata") else . end;
def tokens: number | if . > 0 and . == floor and . <= 9007199254740991 then . else error("Invalid token limit") end;
def rate: number * 1000000 | if isinfinite then error("Price overflow") else . end;
def boolean: if type == "boolean" then . else error("Invalid capability flag") end;
def known: with_entries(select(.value != null));
def rows($key):
	if type != "array" then error("Expected model array") else . end
	| map(if type != "object" then error("Expected model object")
		elif (.[$key] | type) != "string" then error("Missing model ID")
		elif (.[$key] | length) == 0 or (.[$key] | contains("#")) then error("Invalid model ID") else . end)
	| group_by(.[$key])
	| map(unique | if length == 1 then .[0] else error("Conflicting duplicate model IDs") end);
def prices($hour):
	. as $p
	| ({input: $p.prompt, output: $p.completion} | known | map_values(rate))
	+ ({read: $p.input_cache_read,
		write: (if $hour then $p.input_cache_write_1h else $p.input_cache_write end)}
		| known | map_values(rate) | if length > 0 then {cache: .} else {} end);
def costs($p; $hour):
	(if $p.tiers == null then [] elif ($p.tiers | type) != "array" then error("Invalid pricing tiers") else
		$p.tiers | map(. as $t | ($t.above_tokens | tokens) as $size
			| ($t | prices($hour)) + {tier: {type: "context", size: $size}})
		| sort_by(.tier.size)
		| if (map(.tier.size) | unique | length) == length then . else error("Duplicate pricing tier") end
		end) as $tiers
	# Every cost entry needs its own input/output rates. Do not fill absent
	# tier rates or cache prices from the base entry or a previous refresh.
	| [($p | prices($hour)), $tiers[]]
	| map(select(has("input") and has("output")))
	| if length == 0 then null
	  elif length == 1 and .[0].tier == null then .[0] else . end;
def raw_prices:
	. as $i
	| {prompt: .input_cost_per_token, completion: .output_cost_per_token,
		input_cache_read: .cache_read_input_token_cost,
		input_cache_write: .cache_creation_input_token_cost,
		input_cache_write_1h: .cache_creation_input_token_cost_above_1hr} | known
	| . + {tiers: [$i | keys[]
		| capture("^input_cost_per_token_above_(?<n>[0-9]+)(?<unit>k|m)?_tokens$")
		| ("_above_" + .n + (.unit // "") + "_tokens") as $suffix
		| {above_tokens: ((.n | tonumber) * (if .unit == "k" then 1000 elif .unit == "m" then 1000000 else 1 end)),
			prompt: $i["input_cost_per_token" + $suffix], completion: $i["output_cost_per_token" + $suffix],
			input_cache_read: $i["cache_read_input_token_cost" + $suffix],
			input_cache_write: $i["cache_creation_input_token_cost" + $suffix],
			input_cache_write_1h: $i["cache_creation_input_token_cost_above_1hr" + $suffix]} | known]}
	| if .tiers == [] then del(.tiers) else . end;
def reasoning($r; $info):
	if $r.effort_levels != null then
		$r.effort_levels
		| if type != "array" then error("Invalid reasoning efforts")
		  elif all(.[]; type == "string" and length > 0) | not then error("Invalid reasoning effort") else . end
		| if (unique | length) != length then error("Duplicate reasoning efforts") else . end
		| {supported: true, toggle: (index("none") != null), effort: [.[] | select(. != "none")]}
	elif $info.supports_reasoning != null then
		($info.supports_reasoning | boolean) as $supported
		| if $supported then
			{supported: true}
			+ (if $info.supports_none_reasoning_effort != null then {toggle: ($info.supports_none_reasoning_effort | boolean)} else {} end)
			+ (["minimal", "low", "medium", "high", "xhigh", "max"]
				| map(. as $level | select($info["supports_" + $level + "_reasoning_effort"] == true))
				| if length > 0 then {effort: .} else {} end)
		else {supported: false} end
	else null end;
def media($flags):
	if ($flags | length) == 0 then null else
		["text"] + [$flags | to_entries[] | select(.value | boolean) | .key]
	end;
# These are metadata fields, not retained request configuration. Use the same
# boundary for aliases so they cannot reintroduce historical target metadata.
def customizations: del(.cost, .limit, .capabilities, .type, .disabled, .family, .releaseDate);
def current_variants($reasoning):
	if .variants != null then
		.variants |= map(select(
			[.settings.reasoningEffort, .body.reasoning_effort,
				(if (.body.reasoning | type) == "object" then .body.reasoning.effort else null end)]
			| map(select(. != null))
			| all(.[]; . as $effort | $reasoning.supported == true and
				(if $effort == "none" then $reasoning.toggle == true
				 else (($reasoning.effort // []) | index($effort)) != null end))))
	else . end;
def model($row; $info; $old):
	($row.id // $row.model_name) as $id
	| ($row.mode // $info.mode) as $mode
	| if $mode != null and ($mode | type) != "string" then error("Invalid model mode") else . end
	| if ($info | type) != "object" then error("Invalid model_info") else . end
	| if any($info | to_entries[]; (.key | startswith("supports_")) and .value != null and (.value | type) != "boolean")
		then error("Invalid capability flag") else . end
	| if $mode == "embedding" then empty else
	($old.settings.cache.ttl // $provider_settings.cache.ttl // "5m" | IN("1h", "60m", "3600s", "3600000ms")) as $hour
	| (if $row.pricing != null then
		if ($row.pricing | type) == "object" then $row.pricing else error("Invalid pricing") end
		else $info | raw_prices end) as $pricing
	| (costs($pricing; $hour)) as $cost
	| ({context: ($row.context_length // $info.context_length),
		input: ($row.max_input_tokens // $info.max_input_tokens),
		output: ($row.max_output_tokens // $info.max_output_tokens)} | known | map_values(tokens)) as $limit
	| (reasoning($row.reasoning // $info.reasoning // {}; $info)) as $reasoning
	| ({image: $info.supports_vision, audio: $info.supports_audio_input, pdf: $info.supports_pdf_input} | known) as $inputs
	| ({audio: $info.supports_audio_output} | known) as $outputs
	| ({input: media($inputs), output: media($outputs), reasoning: $reasoning} | known) as $caps
	| ($caps + (if $info.supports_function_calling != null then {tools: ($info.supports_function_calling | boolean)}
		elif $info.supports_tool_choice != null then {tools: ($info.supports_tool_choice | boolean)} else {} end)) as $caps
	| ({name: ($id | format_name)} * ($old | customizations))
	| if $cost != null then .cost = $cost else . end
	| if $limit != {} then .limit = $limit else . end
	| if $caps != {} then .capabilities = $caps else . end
	| current_variants($reasoning)
	| if $mode == "responses" then .type = "chat"
		| .package //= "@opencode/ai/providers/openai-compatible/responses"
	  elif $mode == "image_generation" then .type = "image"
		| .disabled = ($old.package == null)
	  elif $mode == "chat" then .type = "chat"
	  elif $mode != null and $mode != "chat" then .disabled = true
	  else . end
	| {key: $id, value: .}
	end;
(.data | rows("id")) as $inventory
| ($inventory | map({key: .id, value: .}) | from_entries) as $records
| (.info | map({model_name, model_info: ((.model_info // {}) | with_entries(select(
	.key | test("^(mode|context_length|max_input_tokens|max_output_tokens|reasoning|supports_.*|.*cost.*)$"))))})
	| rows("model_name") | map({key: .model_name, value: .model_info}) | from_entries) as $info
| [$inventory[] | . as $row | model($row; $info[$row.id] // {}; $previous[$row.id] // {})]
| from_entries as $models
# Preserve configured aliases only while their target is in the new inventory.
| reduce ($previous | to_entries[] | .key as $key | select(.value.modelID != null and ($models | has($key) | not))) as $alias
	($models; $alias.value.modelID as $target | if $models[$target] != null then
		# Rebuild from the same fresh record, applying the effective alias request
		# settings (including cache lifetime) before calculating its metadata.
		.[$alias.key] = (model($records[$target]; $info[$target] // {};
			$models[$target] * ($alias.value | customizations)) | .value) else . end)
| to_entries | sort_by(.value.name, .key) | from_entries
'

# ── Provider helper functions ───────────────────────────────────────

# Convert display name to snake_case provider key
slugify_provider() {  # display_name -> stdout
	local slug=${(L)1}
	slug=${slug//[^a-z0-9]/_}
	slug=${slug//_##/_}
	print -- ${${slug##_}%%_}
}

# Inventory is authoritative even when empty. A successful malformed response is
# an error, not a reason to silently publish a different inventory.
fetch_models() {  # endpoint tmp_file api_key
	local endpoint=$1 tmp=$2 key=$3
	local http_code response=null info='[]' route
	integer info_available=0
	local -a routes=( "${endpoint%/v1}/model/info" "$endpoint/model/info" )
	routes=( ${(u)routes} )

	print -ru2 -- "Fetching model inventory from: $endpoint/models"
	if http_code=$(fetch_route "$endpoint/models" "$tmp" "$key") &&
		[[ $http_code -ge 200 && $http_code -lt 300 ]]; then
		if ! response=$(jq -ce 'if (.data | type) == "array" then .data else error("Expected data array") end' "$tmp"); then
			print -ru2 -- "Error: invalid model inventory"
			return 1
		fi
	elif [[ $http_code != 404 && $http_code != 405 ]]; then
		print -ru2 -- "Error: model inventory unavailable (HTTP $http_code)"
		return 1
	fi

	for route in $routes; do
		if http_code=$(fetch_route "$route" "$tmp" "$key") &&
			[[ $http_code -ge 200 && $http_code -lt 300 ]]; then
			if ! info=$(jq -ce 'if (.data | type) == "array" then .data else error("Expected data array") end' "$tmp"); then
				print -ru2 -- "Error: invalid model metadata"
				return 1
			fi
			vlog "Supplementary metadata: $route"
			info_available=1
			break
		fi
	done
	if [[ $response == null ]]; then
		if (( ! info_available )); then
			print -ru2 -- "Error: no model discovery route available"
			return 1
		fi
		response=$(jq -c 'map({id: .model_name})' <<<"$info") || return $?
	fi
	jq -cn --argjson data "$response" --argjson info "$info" '{data: $data, info: $info}'
}

# ── Config validation ───────────────────────────────────────────────

# Native V2 provider/model checks, based on the V2 docs and their linked
# Config.ProviderEncoded / Config.ModelEncoded API schemas. The editor schema
# at opencode.ai/config.json may still describe V1.
# Reports paths without printing settings or credentials.
local JQ_VALIDATE_CONFIG='
def is_type($t):
	if $t == "integer" then type == "number" and . == floor
	elif $t == "tokens" then type == "number" and . == floor and . > 0 and . <= 9007199254740991
	elif $t == "price" then type == "number" and . >= 0
	elif $t == "strings" then type == "array" and all(.[]; type == "string")
	elif $t == "headers" then type == "object" and all(.[]; type == "string")
	elif $t == "cost" then type == "object" or type == "array"
	else type == $t end;
def fields($p; $types):
	if type != "object" then "Expected object at \($p)"
	else to_entries[] | .key as $k
		| if ($types | has($k) | not) then "Unknown V2 field \($p).\($k)"
		  elif (.value | is_type($types[$k]) | not) then "Invalid type at \($p).\($k)"
		  else empty end
	end;
def nested($k; $t): select(type == "object" and has($k)) | .[$k] | select(is_type($t));
def settings($p):
	(select(has("compaction")) | .compaction
		| fields("\($p).compaction"; {type: "string"}),
		  (select(type == "object") | select(.type | IN("native", "summary") | not) | "Invalid compaction at \($p).compaction"));
def request($p): nested("settings"; "object") | settings("\($p).settings");
def cost($p):
	fields($p; {input: "price", output: "price", cache: "object", tier: "object"}),
	(select(type == "object") | . as $c | ["input", "output"][] | . as $k
		| select($c | has($k) | not) | "Missing key \($p).\($k)"),
	(nested("cache"; "object") | fields("\($p).cache"; {read: "price", write: "price"})),
	(nested("tier"; "object")
		| fields("\($p).tier"; {type: "string", size: "tokens"}),
		  (select(.type != "context" or (has("size") | not)) | "Invalid tier at \($p).tier"));
def compatibility($p; $model):
	fields($p; {reasoningField: "string", requireReasoning: "boolean", maxTokensField: "string",
		requireFinishReason: "boolean", requireAssistantAfterTool: "boolean", supportsPromptCacheKey: "boolean",
		streamUsage: "boolean", cacheFormat: "string", mediaInput: "string"}
		+ (if $model then {supportsThinkingBlockBinding: "boolean", supportsEffortUpdates: "boolean"} else {} end)),
	(select(has("maxTokensField")) | select(.maxTokensField | IN("max_tokens", "max_completion_tokens") | not)
		| "Invalid maxTokensField at \($p)"),
	(select(has("cacheFormat")) | select(.cacheFormat | IN("anthropic", "alibaba") | not) | "Invalid cacheFormat at \($p)");
def reasoning($p):
	fields($p; {supported: "boolean", toggle: "boolean", effort: "strings", budget: "object"}),
	(select(type == "object") | select((has("supported") | not) or (.supported == false and keys != ["supported"]))
		| "Invalid reasoning at \($p)"),
	(nested("budget"; "object") | fields("\($p).budget"; {min: "tokens", max: "tokens"}));
def model($p):
	fields($p; {modelID: "string", name: "string", family: "string", package: "string", type: "string", releaseDate: "string",
		settings: "object", headers: "headers", body: "object", capabilities: "object",
		compatibility: "object", variants: "array", cost: "cost", limit: "object", disabled: "boolean"}),
	request($p),
	(nested("capabilities"; "object")
		| fields("\($p).capabilities"; {tools: "boolean", input: "strings", output: "strings", freeform: "strings", temperature: "boolean", reasoning: "object"}),
		  (nested("reasoning"; "object") | reasoning("\($p).capabilities.reasoning"))),
	(nested("limit"; "object") | fields("\($p).limit"; {context: "tokens", input: "tokens", output: "tokens"})),
	(nested("compatibility"; "object") | compatibility("\($p).compatibility"; true)),
	(nested("variants"; "array") | select((map(.id) | unique | length) != length) | "Duplicate variant IDs at \($p)"),
	(nested("variants"; "array") | to_entries[] | "\($p).variants.\(.key)" as $v | .value
		| fields($v; {id: "string", settings: "object", headers: "headers", body: "object"}),
		  (select(type == "object" and ((has("id") | not) or .id == "")) | "Missing key \($v).id"), request($v)),
	(nested("cost"; "cost") | if type == "array" then to_entries[] | .key as $i | .value | cost("\($p).cost.\($i)") else cost("\($p).cost") end);
def provider($p):
	fields($p; {name: "string", canonical: "string", env: "strings", package: "string",
		settings: "object", headers: "headers", body: "object", models: "object", compatibility: "object"}),
	request($p),
	(nested("compatibility"; "object") | compatibility("\($p).compatibility"; false)),
	(nested("settings"; "object")
		| (to_entries[] | select(.key | IN("timeout", "headerTimeout", "chunkTimeout"))
			| select(.value != false and (.value | type) != "number") | "Invalid timeout at \($p).settings.\(.key)"),
		  (select(has("transport")) | select(.transport | IN("http", "websocket") | not) | "Invalid transport at \($p).settings.transport")),
	(nested("models"; "object") | to_entries[] | .key as $m | .value | model("\($p).models.\($m)"));
[
	if type != "object" then "Expected configuration object"
	elif (.providers | type) != "object" then "Expected object at providers"
	else .providers | to_entries[] | .key as $p | .value | provider("providers.\($p)") end
]
'

# Validate a candidate config file before it replaces the live one.
# Returns: 0 if valid, 1 if invalid
validate_config() {  # candidate_file
	local candidate=$1 problems

	vlog "Validating structure of: $candidate"
	if ! problems=$(jq -r "${JQ_VALIDATE_CONFIG} | .[]" "$candidate"); then
		print -ru2 -- "Error: unable to validate candidate JSON"
		return 1
	fi

	if [[ -n $problems ]]; then
		print -ru2 -- "Error: generated configuration is invalid; refusing to write"
		local line
		while IFS= read -r line; do
			print -ru2 -- "  ↳ $line"
		done <<<"$problems"
		return 1
	fi
	vlog "Structural validation passed"

	# V2 debug config uses the shared service and has no --pure mode. A private
	# server receives OPENCODE_CONFIG for this invocation. Parsing can silently
	# discard invalid fields, so verify the exact document and retained providers.
	if (( $+commands[opencode] )); then
		vlog "Validating with: opencode api --standalone get /api/config"
		local output
		if ! output=$(OPENCODE_CONFIG="${candidate:A}" command opencode api --standalone get /api/config); then
			print -ru2 -- "Error: opencode could not load the generated configuration; refusing to write"
			return 1
		fi
		if ! jq -e --arg candidate "${candidate:A}" --slurpfile expected "$candidate" '
			# Environment/file substitutions are resolved by OpenCode. Check their
			# presence and type; compare all other values recursively and exactly.
			def retained($e):
				. as $actual | if ($e | type) == "object" then
					type == "object" and all($e | keys[]; . as $k | ($actual | has($k)) and ($actual[$k] | retained($e[$k])))
				elif ($e | type) == "array" then
					type == "array" and length == ($e | length) and all($e | keys[]; . as $k | $actual[$k] | retained($e[$k]))
				elif ($e | type) == "string" and ($e | test("\\{(env|file):[^}]+\\}")) then type == "string"
				else . == $e end;
			[.[] | select(.type == "document" and .path == $candidate)]
			| length == 1 and (.[0].info.providers | retained($expected[0].providers))
		' <<<"$output" >/dev/null; then
			print -ru2 -- "Error: opencode did not retain the candidate provider/model settings; refusing to write"
			return 1
		fi
		vlog "opencode validation passed"
	else
		vlog "opencode not found in PATH; skipping authoritative validation"
	fi

	return 0
}

# Update config file atomically with change detection
# Returns: 0 if updated, 1 on error, 2 if no changes
update_config() {  # config_file provider_key display_name base_url new_models
	local config=$1 provider_key=$2 display_name=$3 base_url=$4 new_models=$5
	local work candidate input=$config
	work=$(command mktemp -d "${config:h}/.opencode-models.XXXXXX") || return $?
	# Keep the candidate beside the destination so relative file substitutions,
	# plugins and other config paths resolve exactly as in the live document.
	candidate="$work.json"
	{
	if [[ -f $config ]]; then
		# Retain permissions while writing to a private same-filesystem candidate.
		command cp -p -- "$config" "$candidate" || return $?
	else
		input="$work/initial.json"
		jq -n '{"$schema": "https://opencode.ai/config.json", "providers": {}}' > "$input" || return $?
	fi

	vlog "Writing config to temporary file: $candidate"
	if ! jq --tab \
		--argjson new_models "$new_models" \
		--arg provider "$provider_key" \
		--arg display_name "$display_name" \
		--arg base_url "$base_url" \
		'
		# Models are replaced below. Translate the remaining legacy provider fields
		# as V2 does, separating HTTP headers/body from runtime settings.
		def migrate_provider:
			(.options // {}) as $options
			| .npm as $npm
			| del(.models, .npm, .api, .options, .id, .whitelist, .blacklist)
			+ {settings: ($options | del(.headers, .body, .setCacheKey))}
			+ (if $npm != null then {package: (if $npm | startswith("@ai-sdk/") then "aisdk:" + $npm else $npm end)} else {} end)
			+ (if $options.setCacheKey != null then {compatibility: {supportsPromptCacheKey: $options.setCacheKey}} else {} end)
			+ (if $options | has("headers") then {headers: $options.headers} else {} end)
			+ (if $options | has("body") then {body: $options.body} else {} end);
		def merge_headers($old; $new):
			($new | keys | map(ascii_downcase)) as $names
			| ($old | with_entries(select((.key | ascii_downcase) as $k | $names | index($k) | not))) + $new;
		(.provider[$provider] // {} | migrate_provider) as $legacy
		| (.providers[$provider] // {}) as $native
		| .providers[$provider] = ($legacy * $native
			| if ($legacy | has("headers")) and ($native | has("headers"))
			  then .headers = merge_headers($legacy.headers; $native.headers) else . end)
		| .providers[$provider].models = $new_models
		| .providers[$provider].name = $display_name
		| .providers[$provider].package //= "@opencode/ai/providers/openai-compatible"
		| .providers[$provider].settings.baseURL = $base_url
		| if (.provider // {} | has($provider)) then
			del(.provider[$provider]) | if .provider == {} then del(.provider) else . end
		  else . end
		' \
		"$input" > "$candidate"; then
		print -ru2 -- "Error: failed to write configuration"
		rm -f "$candidate"
		return 1
	fi

	# Never replace a working config with an invalid one.
	if ! validate_config "$candidate"; then
		rm -f "$candidate"
		return 1
	fi

	vlog "Checking for changes against existing config..."
	if [[ -f $config ]] && cmp -s "$candidate" "$config"; then
		vlog "No changes detected, removing temporary file"
		rm -f "$candidate"
		return 2
	fi

	vlog "Changes detected, updating config atomically"
	command mv -- "$candidate" "$config" || {
		command rm -f -- "$candidate"
		return 1
	}
	} always {
		command rm -f -- "$candidate"
		command rm -rf -- "$work"
	}
}

# Print formatted model summary to stderr
print_model_summary() {  # config_file provider_key
	jq -r --arg provider "$2" '
		.providers[$provider].models | to_entries[]
		| .value as $m
		| ([ (if $m.capabilities.tools then "tools" else empty end),
			 (if $m.capabilities.reasoning.supported then "reasoning" else empty end),
			 (if $m.disabled then "disabled" else empty end),
			 (if ($m.capabilities.input // []) | index("image") then "vision" else empty end)
		  ] | if length > 0 then " [" + join(",") + "]" else "" end) as $flags
		| "\t\($m.name) (\(.key))\($flags)"
	' "$1" >&2
}

# ── Main provider processing ────────────────────────────────────────
process_provider() {
	local display=$1 endpoint=$2 key=$3 config=$4
	local provider_key fetch_result new_models tmp previous='{}' provider_settings='{}'
	integer model_count

	provider_key=$(slugify_provider "$display")
	if [[ -z $provider_key ]]; then
		print -ru2 -- "Error: provider name must contain an ASCII letter or digit"
		return 1
	fi
	vlog "Generated provider key: '$provider_key' from '$display'"

	tmp=$(command mktemp "${TMPDIR:-/tmp}/opencode_models.XXXXXX") || return $?
	vlog "Created temporary file: $tmp"

{
	# Fetch models from API
	vlog "Starting model fetch from API..."
	if ! fetch_result=$(fetch_models "$endpoint" "$tmp" "$key"); then
		return 1
	fi
	if [[ -f $config ]]; then
		previous=$(jq -ce --arg provider "$provider_key" '.providers[$provider].models // {}' "$config") || return $?
		provider_settings=$(jq -ce --arg provider "$provider_key" '(.provider[$provider].options // {}) * (.providers[$provider].settings // {})' "$config") || return $?
	fi

	# OpenCode token costs cannot represent independent media/query/service-tier
	# charges. Report their presence without guessing a text-token equivalent.
	if jq -e 'any(.info[].model_info // {} | to_entries[]; .value != null and
		(.key | test("cost.*(image|audio|query|priority|batches|flex)|search_context_cost")))' <<<"$fetch_result" >/dev/null; then
		print -ru2 -- "Note: media, query and service-tier charges are not included in text-token cost estimates"
	fi

	# Transform to opencode schema
	vlog "Transforming API response to opencode schema..."
	if ! new_models=$(jq --argjson previous "$previous" --argjson provider_settings "$provider_settings" \
		"${JQ_FORMAT_NAME}${JQ_TRANSFORM_MODELS}" <<<"$fetch_result"); then
		print -ru2 -- "Error: failed to parse model data"
		return 1
	fi

	model_count=$(jq 'length' <<<"$new_models") || return $?
	vlog "Transformed $model_count models"
	(( model_count == 0 )) && print -ru2 -- "Warning: no models found at endpoint"

	# Update config atomically
	vlog "Updating configuration file..."
	local ret=0
	update_config "$config" "$provider_key" "$display" "$endpoint" "$new_models" || ret=$?
	case $ret in
		0) ;;
		2) print -ru2 -- "No changes detected for provider: $display"; return 0 ;;
		*) return 1 ;;
	esac

	print -ru2 -- "Successfully updated provider: $display ($model_count models)"

	if (( model_count > 0 )); then
		print -ru2 -- "Models:"
		print_model_summary "$config" "$provider_key" || return $?
	fi
	return 0
} always {
	vlog "Cleanup: removing temporary file $tmp"
	command rm -f -- "$tmp"
}
}

# ── Main ────────────────────────────────────────────────────────────

# Resolve symlinks before atomic replacement. Bootstrap only after discovery and
# validation succeed, so a failed first refresh leaves no configuration behind.
config_file=${config_file:A}
vlog "Checking config file: $config_file"
if [[ -e $config_file && ! -w $config_file ]] || [[ ! -d ${config_file:h} || ! -w ${config_file:h} ]]; then
	print -ru2 -- "Error: configuration file '$config_file' is not writable"
	return 1
fi
vlog "Config file is writable"

# Process the provider
vlog "Starting provider processing..."
process_provider "$provider_name" "$api_endpoint" "$API_KEY" "$config_file" || return $?
vlog "Provider processing complete"
)
