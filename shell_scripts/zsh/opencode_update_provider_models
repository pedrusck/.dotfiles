#!/usr/bin/env zsh

emulate -L zsh
setopt pipefail extendedglob

# Keep this autoload interface while containing helper definitions and state.
(

# Usage: API_KEY=<key> opencode_update_provider_models [OPTIONS] <PROVIDER_NAME> <API_ENDPOINT> [CONFIG_FILE]
#
# Options:
#	-v, --verbose	Enable detailed step-by-step logging.
#	-h, --help		Show this help message and exit.
#
# Arguments:
#	PROVIDER_NAME	Human-readable provider name (converted to snake_case for the key).
#	API_ENDPOINT	OpenAI-compatible API endpoint.
#	CONFIG_FILE		opencode config file path (default: opencode.json).
#
# Environment variables:
#	API_KEY			API key for authentication (required).
#
# Behavior:
#	Fetches models from the provider endpoint and updates the configuration file.
#	Prefers the LiteLLM-style `<endpoint>/model/info` route (rich metadata: costs,
#	limits, modalities, capability flags) mapped onto OpenCode's native V2 schema, keeping
#	chat models only. If unavailable, falls back to the plain `<endpoint>/models` route
#	(names only).
#
#	The provider's models key is completely rewritten (no per-model update).
#	Migrates this provider's legacy settings to native V2, preserving native overrides.
#	If the config file doesn't exist, it will be created.
#
# Exit codes:
#	0	Success
#	nonzero	Error (validation, fetch, transformation, or filesystem failure)
#
# Examples:
#	API_KEY=sk-xxx opencode_update_provider_models "OpenAI Compatible" https://api.example.com opencode.json
#	API_KEY=sk-xxx opencode_update_provider_models --verbose "OpenAI Compatible" https://api.example.com

# ── Help ────────────────────────────────────────────────────────────
local -r SCRIPT_NAME=${0:t}

print_usage() {
	print -ru2 -- "Usage: API_KEY=<key> $SCRIPT_NAME [OPTIONS] <PROVIDER_NAME> <API_ENDPOINT> [CONFIG_FILE]"
	print -ru2 -- ""
	print -ru2 -- "Options:"
	print -ru2 -- "  -v, --verbose   Enable detailed step-by-step logging"
	print -ru2 -- "  -h, --help      Show this help message and exit"
	print -ru2 -- ""
	print -ru2 -- "Arguments:"
	print -ru2 -- "  PROVIDER_NAME   Human-readable provider name (converted to snake_case)"
	print -ru2 -- "  API_ENDPOINT    OpenAI-compatible API endpoint (must use https://)"
	print -ru2 -- "  CONFIG_FILE     Config file path (default: opencode.json)"
	print -ru2 -- ""
	print -ru2 -- "Environment:"
	print -ru2 -- "  API_KEY         API key for authentication (required)"
}

# ── Option parsing ──────────────────────────────────────────────────
integer verbose=0

while (( $# > 0 )) && [[ $1 == -* ]]; do
	case $1 in
		-v|--verbose) verbose=1; shift ;;
		-h|--help) print_usage; return 0 ;;
		--) shift; break ;;
		-*) print -ru2 -- "Error: unknown option: $1"; print_usage; return 1 ;;
	esac
done

# ── Verbose logging helper ──────────────────────────────────────────
vlog() {
	(( verbose )) && print -ru2 -- "[VERBOSE] $*" || :
}

# ── Dependencies ────────────────────────────────────────────────────
local cmd
for cmd (curl jq); do
	if (( ! $+commands[$cmd] )); then
		print -ru2 -- "Error: $cmd is required but not installed"
		return 1
	fi
	vlog "Dependency check: $cmd found"
done

# ── Argument validation ─────────────────────────────────────────────
if (( $# < 2 || $# > 3 )); then
	print -ru2 -- "Error: expected 2-3 arguments, got $#"
	print_usage
	return 1
fi

local provider_name=$1 api_endpoint=$2 config_file=${3:-opencode.json}

if [[ -z $provider_name ]]; then
	print -ru2 -- "Error: PROVIDER_NAME cannot be empty"
	return 1
fi

if [[ -z $api_endpoint ]]; then
	print -ru2 -- "Error: API_ENDPOINT cannot be empty"
	return 1
fi

if [[ $api_endpoint != https://* ]]; then
	print -ru2 -- "Error: API_ENDPOINT must start with https://"
	return 1
fi

if [[ -z ${API_KEY:-} ]]; then
	print -ru2 -- "Error: API_KEY environment variable is required"
	return 1
fi

vlog "Config: provider='$provider_name' endpoint='$api_endpoint' file='$config_file'"

# ── Fetch a single route into a file, printing the HTTP status code ─
fetch_route() {  # url out key
	vlog "HTTP request: $1"
	local http_code
	http_code=$(curl -sL -o "$2" -w '%{http_code}' \
		--max-time 10 --connect-timeout 3 \
		-H "Authorization: Bearer $3" \
		-H "Content-Type: application/json" \
		"$1") || return $?
	vlog "HTTP response: $http_code"
	print -- "$http_code"
}

# ── jq definitions ──────────────────────────────────────────────────

# Turn a raw model id into a human-friendly display name
local JQ_FORMAT_NAME='
def format_name:
	gsub("[/_]"; "-")
	# Protect param sizes: 3-27b -> 3 27b (space, not dot)
	| gsub("(?<d1>[0-9])-(?<d2>[0-9]+b)"; "\(.d1) \(.d2)")
	# Merge remaining version digits: 3-3 -> 3.3
	| gsub("(?<d1>[0-9])-(?<d2>[0-9])"; "\(.d1).\(.d2)")
	| split("-")
	| map((.[0:1] | ascii_upcase) + (.[1:] | ascii_downcase))
	| join(" ")
	# Uppercase known acronyms
	| gsub("(?<pre>^| )Gpt(?<post> |$)"; "\(.pre)GPT\(.post)")
	| gsub("(?<pre>^| )Oss(?<post> |$)"; "\(.pre)OSS\(.post)")
	| gsub("(?<pre>^| )It(?<post> |$)"; "\(.pre)IT\(.post)")
	# Lowercase version prefix
	| gsub("(?<pre>^| )V(?<version>[0-9.]+)(?<post> |$)"; "\(.pre)v\(.version)\(.post)")
	# Uppercase parameter sizes (7b -> 7B, 120b -> 120B)
	| gsub("(?<pre>^| )(?<num>[0-9.]+)b(?<post> |$)"; "\(.pre)\(.num)B\(.post)");
'

# Transform API response to opencode model schema
local JQ_TRANSFORM_MODELS='
def to_num: if type == "string" then (tonumber // 0) else (. // 0) end;
def fmt: ((to_num * 1000000 * 10000 | floor) / 10000);

def rich:
	# Keep chat models only (null/missing mode treated as chat)
	map(select((.model_info.mode // "chat") == "chat"))
	| map(
		.model_name as $name
		| (.model_info // {}) as $info
		|
		(["text"]
			+ (if $info.supports_vision then ["image"] else [] end)
			+ (if $info.supports_audio_input then ["audio"] else [] end)
			+ (if $info.supports_pdf_input then ["pdf"] else [] end)) as $input_mod
		| (["text"] + (if $info.supports_audio_output then ["audio"] else [] end)) as $output_mod
		|
		# V2 requires both `input` and `output` on each cost entry;
		# emit nothing rather than a partial object that fails validation.
		(if ($info.input_cost_per_token != null and $info.output_cost_per_token != null)
			then ({input: ($info.input_cost_per_token | fmt), output: ($info.output_cost_per_token | fmt)}
				+ (if ($info.cache_read_input_token_cost != null or $info.cache_creation_input_token_cost != null)
					then {cache:
						((if $info.cache_read_input_token_cost != null then {read: ($info.cache_read_input_token_cost | fmt)} else {} end)
						+ (if $info.cache_creation_input_token_cost != null then {write: ($info.cache_creation_input_token_cost | fmt)} else {} end))}
					else {} end))
			else {} end) as $cost
		|
		# Preserve the existing all-or-nothing limit inference. V2 also accepts
		# partial limits on models configured by the user.
		($info.max_input_tokens // $info.max_tokens) as $ctx
		| ($info.max_output_tokens // $info.max_tokens) as $out
		| (if ($ctx != null and $out != null)
			then ({context: $ctx}
				+ (if $info.max_input_tokens != null then {input: $info.max_input_tokens} else {} end)
				+ {output: $out})
			else {} end) as $limit
		|
		(($info.supports_function_calling == true) or ($info.supports_tool_choice == true)) as $tool_call
		| ($info.supports_reasoning == true) as $reasoning
		|
		{
			id: $name,
			name: ($name | format_name),
			capabilities: {tools: $tool_call, input: $input_mod, output: $output_mod}
		}
		+ (if ($cost | length) > 0 then {cost: $cost} else {} end)
		+ (if ($limit | length) > 0 then {limit: $limit} else {} end)
		# V2 ignores the legacy reasoning/attachment/temperature booleans.
		# Reasoning models retain their low/high effort variants.
		+ (if $reasoning then {variants: [
			{id: "low", settings: {reasoningEffort: "low"}},
			{id: "high", settings: {reasoningEffort: "high"}}
		]} else {} end)
	);

def basic: map({id: .id, name: (.id | format_name)});

.data
| (if $mode == "rich" then rich else basic end)
| sort_by(.name)
| map({(.id): (del(.id))})
| add // {}
'

# ── Provider helper functions ───────────────────────────────────────

# Convert display name to snake_case provider key
slugify_provider() {  # display_name -> stdout
	local slug=${(L)1}
	slug=${slug//[^a-z0-9]/_}
	slug=${slug//_##/_}
	print -- ${${slug##_}%%_}
}

# Fetch models from API endpoint (tries rich metadata first, falls back to basic)
# Outputs JSON: {"mode": "rich"|"basic", "response": <api_response>}
fetch_models() {  # endpoint tmp_file api_key
	local endpoint=$1 tmp=$2 key=$3
	local http_code mode=basic response

	print -ru2 -- "Fetching rich model metadata from: $endpoint/model/info"
	if http_code=$(fetch_route "$endpoint/model/info" "$tmp" "$key") &&
		[[ $http_code -ge 200 && $http_code -lt 300 ]] && jq -e '.data[0].model_info' "$tmp" &>/dev/null; then
		mode=rich
		print -ru2 -- "Using rich metadata (/model/info)"
		vlog "Response size: $(wc -c < "$tmp" | tr -d ' ') bytes"
	else
		print -ru2 -- "Rich metadata unavailable (HTTP $http_code); falling back to: $endpoint/models"
		http_code=$(fetch_route "$endpoint/models" "$tmp" "$key") || return $?
		if [[ $http_code -lt 200 || $http_code -ge 300 ]]; then
			print -ru2 -- "Error: endpoint returned HTTP $http_code"
			print -ru2 -- "$(<$tmp)"
			return 1
		fi
		vlog "Response size: $(wc -c < "$tmp" | tr -d ' ') bytes"
	fi

	response=$(<$tmp)
	vlog "Selected metadata mode: $mode"

	if ! jq -e '.data' <<<"$response" &>/dev/null; then
		print -ru2 -- "Error: invalid response (not valid JSON or missing 'data' field)"
		print -ru2 -- "Response: $response"
		return 1
	fi

	vlog "Response validation: valid JSON with 'data' field"
	jq -c --arg mode "$mode" '{mode: $mode, response: .}' <<<"$response"
}

# ── Config validation ───────────────────────────────────────────────

# Native V2 provider/model checks, based on the V2 docs and their linked
# Config.ProviderEncoded / Config.ModelEncoded API schemas. The editor schema
# at opencode.ai/config.json may still describe V1.
# Reports paths without printing settings or credentials.
local JQ_VALIDATE_CONFIG='
def is_type($t):
	if $t == "integer" then type == "number" and . == floor
	elif $t == "strings" then type == "array" and all(.[]; type == "string")
	elif $t == "headers" then type == "object" and all(.[]; type == "string")
	elif $t == "cost" then type == "object" or type == "array"
	else type == $t end;
def fields($p; $types):
	if type != "object" then "Expected object at \($p)"
	else to_entries[] | .key as $k
		| if ($types | has($k) | not) then "Unknown V2 field \($p).\($k)"
		  elif (.value | is_type($types[$k]) | not) then "Invalid type at \($p).\($k)"
		  else empty end
	end;
def nested($k; $t): select(type == "object" and has($k)) | .[$k] | select(is_type($t));
def settings($p):
	(select(has("compaction")) | .compaction
		| fields("\($p).compaction"; {type: "string"}),
		  (select(type == "object") | select(.type | IN("native", "summary") | not) | "Invalid compaction at \($p).compaction"));
def request($p): nested("settings"; "object") | settings("\($p).settings");
def cost($p):
	fields($p; {input: "number", output: "number", cache: "object", tier: "object"}),
	(select(type == "object") | . as $c | ["input", "output"][] | . as $k
		| select($c | has($k) | not) | "Missing key \($p).\($k)"),
	(nested("cache"; "object") | fields("\($p).cache"; {read: "number", write: "number"})),
	(nested("tier"; "object")
		| fields("\($p).tier"; {type: "string", size: "integer"}),
		  (select(.type != "context" or (has("size") | not)) | "Invalid tier at \($p).tier"));
def model($p):
	fields($p; {modelID: "string", name: "string", family: "string", package: "string",
		settings: "object", headers: "headers", body: "object", capabilities: "object",
		compatibility: "object", variants: "array", cost: "cost", limit: "object", disabled: "boolean"}),
	request($p),
	(nested("capabilities"; "object") | fields("\($p).capabilities"; {tools: "boolean", input: "strings", output: "strings"})),
	(nested("limit"; "object") | fields("\($p).limit"; {context: "integer", input: "integer", output: "integer"})),
	(nested("compatibility"; "object")
		| fields("\($p).compatibility"; {reasoningField: "string", requireReasoning: "boolean", maxTokensField: "string",
			requireFinishReason: "boolean", requireAssistantAfterTool: "boolean", supportsPromptCacheKey: "boolean",
			supportsThinkingBlockBinding: "boolean", supportsEffortUpdates: "boolean"}),
		  (select(has("maxTokensField")) | select(.maxTokensField | IN("max_tokens", "max_completion_tokens") | not)
			| "Invalid maxTokensField at \($p).compatibility")),
	(nested("variants"; "array") | to_entries[] | "\($p).variants.\(.key)" as $v | .value
		| fields($v; {id: "string", settings: "object", headers: "headers", body: "object"}),
		  (select(type == "object" and (has("id") | not)) | "Missing key \($v).id"), request($v)),
	(nested("cost"; "cost") | if type == "array" then to_entries[] | .key as $i | .value | cost("\($p).cost.\($i)") else cost("\($p).cost") end);
def provider($p):
	fields($p; {name: "string", canonical: "string", env: "strings", package: "string",
		settings: "object", headers: "headers", body: "object", models: "object"}),
	request($p),
	(nested("settings"; "object")
		| (to_entries[] | select(.key | IN("timeout", "headerTimeout", "chunkTimeout"))
			| select(.value != false and (.value | type) != "number") | "Invalid timeout at \($p).settings.\(.key)"),
		  (select(has("transport")) | select(.transport | IN("http", "websocket") | not) | "Invalid transport at \($p).settings.transport")),
	(nested("models"; "object") | to_entries[] | .key as $m | .value | model("\($p).models.\($m)"));
[
	if type != "object" then "Expected configuration object"
	elif (.providers | type) != "object" then "Expected object at providers"
	else .providers | to_entries[] | .key as $p | .value | provider("providers.\($p)") end
]
'

# Validate a candidate config file before it replaces the live one.
# Returns: 0 if valid, 1 if invalid
validate_config() {  # candidate_file
	local candidate=$1 problems

	vlog "Validating structure of: $candidate"
	if ! problems=$(jq -r "${JQ_VALIDATE_CONFIG} | .[]" "$candidate"); then
		print -ru2 -- "Error: unable to validate candidate JSON"
		return 1
	fi

	if [[ -n $problems ]]; then
		print -ru2 -- "Error: generated configuration is invalid; refusing to write"
		local line
		while IFS= read -r line; do
			print -ru2 -- "  ↳ $line"
		done <<<"$problems"
		return 1
	fi
	vlog "Structural validation passed"

	# V2 debug config uses the shared service and has no --pure mode. A private
	# server receives OPENCODE_CONFIG for this invocation. Parsing can silently
	# discard invalid fields, so verify the exact document and retained providers.
	if (( $+commands[opencode] )); then
		vlog "Validating with: opencode api --standalone get /api/config"
		local output
		if ! output=$(OPENCODE_CONFIG="${candidate:A}" command opencode api --standalone get /api/config); then
			print -ru2 -- "Error: opencode could not load the generated configuration; refusing to write"
			return 1
		fi
		if ! jq -e --arg candidate "${candidate:A}" --slurpfile expected "$candidate" '
			# Environment/file substitutions are resolved by OpenCode. Check their
			# presence and type; compare all other values recursively and exactly.
			def retained($e):
				. as $actual | if ($e | type) == "object" then
					type == "object" and all($e | keys[]; . as $k | ($actual | has($k)) and ($actual[$k] | retained($e[$k])))
				elif ($e | type) == "array" then
					type == "array" and length == ($e | length) and all($e | keys[]; . as $k | $actual[$k] | retained($e[$k]))
				elif ($e | type) == "string" and ($e | test("\\{(env|file):[^}]+\\}")) then type == "string"
				else . == $e end;
			[.[] | select(.type == "document" and .path == $candidate)]
			| length == 1 and (.[0].info.providers | retained($expected[0].providers))
		' <<<"$output" >/dev/null; then
			print -ru2 -- "Error: opencode did not retain the candidate provider/model settings; refusing to write"
			return 1
		fi
		vlog "opencode validation passed"
	else
		vlog "opencode not found in PATH; skipping authoritative validation"
	fi

	return 0
}

# Update config file atomically with change detection
# Returns: 0 if updated, 1 on error, 2 if no changes
update_config() {  # config_file provider_key display_name base_url new_models
	local config=$1 provider_key=$2 display_name=$3 base_url=$4 new_models=$5
	# Keep a .json suffix so validation sees the same extension as the real file.
	local candidate="$config.tmp.json"

	vlog "Writing config to temporary file: $candidate"
	if ! jq --tab \
		--argjson new_models "$new_models" \
		--arg provider "$provider_key" \
		--arg display_name "$display_name" \
		--arg base_url "$base_url" \
		'
		# Models are replaced below. Translate the remaining legacy provider fields
		# as V2 does, separating HTTP headers/body from runtime settings.
		def migrate_provider:
			(.options // {}) as $options
			| del(.models, .npm, .api, .options, .id, .whitelist, .blacklist)
			+ {settings: ($options | del(.headers, .body))}
			+ (if $options | has("headers") then {headers: $options.headers} else {} end)
			+ (if $options | has("body") then {body: $options.body} else {} end);
		def merge_headers($old; $new):
			($new | keys | map(ascii_downcase)) as $names
			| ($old | with_entries(select((.key | ascii_downcase) as $k | $names | index($k) | not))) + $new;
		(.provider[$provider] // {} | migrate_provider) as $legacy
		| (.providers[$provider] // {}) as $native
		| .providers[$provider] = ($legacy * $native
			| if ($legacy | has("headers")) and ($native | has("headers"))
			  then .headers = merge_headers($legacy.headers; $native.headers) else . end)
		| .providers[$provider].models = $new_models
		| .providers[$provider].name = $display_name
		| .providers[$provider].package = "aisdk:@ai-sdk/openai-compatible"
		| .providers[$provider].settings.baseURL = $base_url
		| if (.provider // {} | has($provider)) then
			del(.provider[$provider]) | if .provider == {} then del(.provider) else . end
		  else . end
		' \
		"$config" > "$candidate"; then
		print -ru2 -- "Error: failed to write configuration"
		rm -f "$candidate"
		return 1
	fi

	# Never replace a working config with an invalid one.
	if ! validate_config "$candidate"; then
		rm -f "$candidate"
		return 1
	fi

	vlog "Checking for changes against existing config..."
	if cmp -s "$candidate" "$config"; then
		vlog "No changes detected, removing temporary file"
		rm -f "$candidate"
		return 2
	fi

	vlog "Changes detected, updating config atomically"
	command mv -- "$candidate" "$config" || {
		command rm -f -- "$candidate"
		return 1
	}
}

# Print formatted model summary to stderr
print_model_summary() {  # config_file provider_key
	jq -r --arg provider "$2" '
		.providers[$provider].models | to_entries[]
		| .value as $m
		| ([ (if $m.capabilities.tools then "tools" else empty end),
			 (if any($m.variants[]?; .settings.reasoningEffort != null) then "reasoning" else empty end),
			 (if ($m.capabilities.input // []) | index("image") then "vision" else empty end)
		  ] | if length > 0 then " [" + join(",") + "]" else "" end) as $flags
		| "\t\($m.name) (\(.key))\($flags)"
	' "$1" >&2
}

# ── Main provider processing ────────────────────────────────────────
process_provider() {
	local display=$1 endpoint=$2 key=$3 config=$4
	local provider_key fetch_result fetch_mode models_response new_models tmp
	integer model_count

	provider_key=$(slugify_provider "$display")
	vlog "Generated provider key: '$provider_key' from '$display'"

	tmp=$(command mktemp "${TMPDIR:-/tmp}/opencode_models.XXXXXX") || return $?
	vlog "Created temporary file: $tmp"

{
	# Fetch models from API
	vlog "Starting model fetch from API..."
	if ! fetch_result=$(fetch_models "$endpoint" "$tmp" "$key"); then
		return 1
	fi
	fetch_mode=$(jq -r '.mode' <<<"$fetch_result") || return $?
	models_response=$(jq -c '.response' <<<"$fetch_result") || return $?

	# Transform to opencode schema
	vlog "Transforming API response to opencode schema..."
	if ! new_models=$(jq --arg mode "$fetch_mode" \
		"${JQ_FORMAT_NAME}${JQ_TRANSFORM_MODELS}" <<<"$models_response"); then
		print -ru2 -- "Error: failed to parse model data"
		return 1
	fi

	model_count=$(jq 'length' <<<"$new_models") || return $?
	vlog "Transformed $model_count models (mode: $fetch_mode)"
	(( model_count == 0 )) && print -ru2 -- "Warning: no models found at endpoint"

	# Update config atomically
	vlog "Updating configuration file..."
	local ret=0
	update_config "$config" "$provider_key" "$display" "$endpoint" "$new_models" || ret=$?
	case $ret in
		0) ;;
		2) print -ru2 -- "No changes detected for provider: $display"; return 0 ;;
		*) return 1 ;;
	esac

	print -ru2 -- "Successfully updated provider: $display ($model_count models, $fetch_mode metadata)"

	if (( model_count > 0 )); then
		print -ru2 -- "Models:"
		print_model_summary "$config" "$provider_key" || return $?
	fi
	return 0
} always {
	vlog "Cleanup: removing temporary file $tmp"
	command rm -f -- "$tmp"
}
}

# ── Main ────────────────────────────────────────────────────────────

# Bootstrap config file if it doesn't exist.
vlog "Checking config file: $config_file"
if [[ ! -f $config_file ]]; then
	print -ru2 -- "Configuration file '$config_file' not found; creating it"
	jq -n --tab '{
		"$schema": "https://opencode.ai/config.json",
		"update": "auto",
		"providers": {}
	}' > "$config_file" || return $?
	vlog "Created new config file with default schema"
else
	vlog "Config file exists"
fi

if [[ ! -w $config_file ]]; then
	print -ru2 -- "Error: configuration file '$config_file' is not writable"
	return 1
fi
vlog "Config file is writable"

# Process the provider
vlog "Starting provider processing..."
process_provider "$provider_name" "$api_endpoint" "$API_KEY" "$config_file" || return $?
vlog "Provider processing complete"
)
