#!/usr/bin/env zsh

emulate -L zsh

# Add requested identities, or the default key files, to the macOS SSH agent.
local id file line sig lines result
local -a identities=("$@") loaded_sigs=() fields=()
local -aU not_loaded=()

if (( $#identities == 0 )); then
	for id in id_rsa id_dsa id_ecdsa id_ed25519 identity; do
		[[ -f $HOME/.ssh/$id ]] && identities+=("$id")
	done
fi
(( $#identities )) || return 0

if lines=$(command ssh-add -l); then
	for line in "${(@f)lines}"; do
		fields=(${=line})
		(( $#fields >= 2 )) && loaded_sigs+=("$fields[2]")
	done
else
	result=$?
	# ssh-add returns 1 for an empty agent, 2 when it cannot contact the agent.
	(( result == 1 )) || return "$result"
fi

for id in "${identities[@]}"; do
	file=$id
	[[ $file == /* ]] || file="$HOME/.ssh/$file"
	line=$(command ssh-keygen -lf "$file") || return $?
	fields=(${=line})
	(( $#fields >= 2 )) || { print -ru2 -- "ssh_add_identities: missing fingerprint: $file"; return 1; }
	sig=$fields[2]
	(( ${loaded_sigs[(Ie)$sig]} )) || not_loaded+=("$file")
done

(( $#not_loaded )) || return 0
command ssh-add --apple-use-keychain "${not_loaded[@]}"
