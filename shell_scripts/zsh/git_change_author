#!/usr/bin/env zsh

emulate -L zsh

if (( $# != 2 )) || [[ -z $1 || -z $2 ]]; then
	print -ru2 -- 'Usage: git_change_author <name> <email>'
	return 1
fi

FILTER_AUTHOR_NAME="$1" FILTER_AUTHOR_EMAIL="$2" command git filter-branch -f --env-filter '
export GIT_AUTHOR_NAME="$FILTER_AUTHOR_NAME" GIT_AUTHOR_EMAIL="$FILTER_AUTHOR_EMAIL"
export GIT_COMMITTER_NAME="$FILTER_AUTHOR_NAME" GIT_COMMITTER_EMAIL="$FILTER_AUTHOR_EMAIL"
' HEAD
