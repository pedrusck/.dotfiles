#!/usr/bin/env zsh

emulate -L zsh
setopt pipefail

(( $# <= 1 )) || { print -ru2 -- 'Usage: xcode_projects_list [name-pattern]'; return 1; }

local -a projects=()
local project search_pattern="*${1-}*.xcodeproj" REPLY

print -r -- 'Collecting .xcodeproj...'
# Zsh retains the array built by the final pipeline component in this function.
command find . -iname "$search_pattern" -type d -print0 | command sort -z |
	while IFS= read -r -d '' project; do
		projects+=("$project")
	done || return $?

if (( $#projects == 0 )); then
	print -r -- 'The project not found.'
	return 0
elif (( $#projects == 1 )); then
	project=$projects[1]
else
	print -r -- 'Please select a project:'
	project=''
	select project in "${projects[@]}"; do
		[[ -n $project ]] && break
		print -r -- '>>> Invalid Selection'
	done
	# EOF cancels selection without opening an empty path.
	[[ -n $project ]] || return 1
fi

print -r -- "Opening $project..."
command xed "$project"
