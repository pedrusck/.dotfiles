#!/usr/bin/env zsh

# Imports the key pair produced by `gpg_export_key` and marks every imported
# primary key as ultimately trusted. Trust is applied unconditionally: importing
# a private key means the key belongs to the user, which is what it encodes.
#
# Usage: gpg_import_key <FILE_NAME>
#	FILE_NAME	Base name; reads <FILE_NAME>_public.gpg and <FILE_NAME>_private.gpg.
#
# Both files are checked before anything is imported, so a missing or unreadable
# one cannot leave the keyring half-populated. Importing the private key needs
# its passphrase, so gpg may open a pinentry prompt (hence no `--batch`).
#
# Autoloaded as a zsh function (see `custom_functions_to_load` in `zsh/zshrc`), so
# it runs in the current shell: it must use `return`, never `exit`, and must not
# set `errexit`/`nounset`, which would abort the interactive shell on failure.
setopt local_options pipefail

(( $+commands[gpg] )) || { print -ru2 -- "Error: gpg is required but not installed"; return 1 }

(( $# == 1 )) || { print -ru2 -- "Usage: gpg_import_key <FILE_NAME>"; return 1 }

local -r file_name=$1
[[ -n $file_name ]] || { print -ru2 -- "Error: FILE_NAME cannot be empty"; return 1 }

local -r public_file="${file_name}_public.gpg" private_file="${file_name}_private.gpg"

local key_file
for key_file in "$public_file" "$private_file"; do
	[[ -f $key_file && -r $key_file ]] \
		|| { print -ru2 -- "Error: file not found or not readable: $key_file"; return 1 }
done

gpg --import "$public_file" \
	|| { print -ru2 -- "Error: failed to import public key from: $public_file"; return 1 }

gpg --import "$private_file" \
	|| { print -ru2 -- "Error: failed to import private key from: $private_file"; return 1 }

# Collect the fingerprint of every *primary* key. The `pub` gate matters: an
# unfiltered `fpr` match would also return subkey fingerprints, which cannot
# carry an ownertrust value.
local fingerprints
fingerprints=$(gpg --show-keys --with-colons "$public_file" \
	| awk -F: '$1 == "pub" { want = 1; next } $1 == "fpr" && want { print $10; want = 0 }')

[[ -n $fingerprints ]] \
	|| { print -ru2 -- "Error: no primary key fingerprint found in: $public_file"; return 1 }

# Ownertrust `ultimate` is the unattended equivalent of `5` in the
# `gpg --edit-key <KeyID>` trust menu, and is stored as `6` in the trustdb.
local fingerprint
for fingerprint in ${(f)fingerprints}; do
	gpg --batch --quick-set-ownertrust "$fingerprint" ultimate \
		|| { print -ru2 -- "Error: failed to set ultimate trust for: $fingerprint"; return 1 }

	print -r -- "Set ultimate trust for key: $fingerprint"
done
