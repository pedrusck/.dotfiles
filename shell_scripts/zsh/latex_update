#!/usr/bin/env zsh

emulate -L zsh

(( $# == 0 )) || { print -ru2 -- 'Usage: latex_update'; return 1; }
(( $+commands[tlmgr] )) || { print -ru2 -- 'TeX Live Manager not installed'; return 1 }

# Update TeX Live Manager
command sudo tlmgr update --self || return $?

# Update all packages reinstalling corrupted ones
command sudo tlmgr update --all --reinstall-forcibly-removed || return $?

command sudo tlmgr backup --clean --all
