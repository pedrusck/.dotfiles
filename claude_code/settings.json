{
  "apiKeyHelper": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/anthropic_key.sh\"",
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__pencil"
    ]
  },
  "theme": "dark"
}
