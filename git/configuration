[alias]
	graph = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'
	lol = log --oneline --decorate

[branch]
	sort = -committerdate # sort by newest branch-tip commit

[column]
	ui = auto # for supported commands show in columns if the output is to the terminal

[commit]
	verbose = true

[core]
	editor = nvim
	pager = delta
	fsmonitor = true
	untrackedcache = true

[credential]
	helper = osxkeychain

[delta]
	dark = true      # use dark mode for terminals with a dark background
	inspect-raw-lines = false
	line-numbers = true
	navigate = true    # use n and N to move between diff sections
	syntax-theme = gruvbox-dark
	tabs = 4

[diff]
	algorithm = histogram
	colorMoved = true
	mnemonicPrefix = true

[difftool]
	prompt = true

[fetch]
	prune = true
	pruneTags = false # opt in per remote when intentionally mirroring tags
	writeCommitGraph = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
	smudge = git-lfs smudge -- %f

[help]
	autocorrect = prompt

[init]
	defaultBranch = main

[interactive]
	diffFilter = delta --color-only

[log]
	date = iso

[merge]
	conflictstyle = zdiff3
	tool = nvimdiff

[mergetool]
	prompt = false # automatically launch merge tool without displaying a prompt

[pull]
	rebase = true

[push]
	autosetupremote = true
	followtags = true # push new tags along with commits being pushed
	recurseSubmodules = on-demand

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[rerere] # REuse REcorded REsolution - Remember the resolution of git merge conflicts and automatically fix them on new occurrences
	enabled = true
	autoupdate = true

[submodule]
	recurse = true

[tag]
	sort = version:refname

[transfer]
	fsckObjects = true # validate incoming objects on fetch and receive

[user]
	name = Pere Bohigas

[include]
	path = additional_configuration/configuration.secret.gitconfig
