## Login environment (also read by non-interactive `zsh -lc`).

typeset -U path fpath

# Enforced locale and editor preferences, including inherited environments.
export LANG=en_US.UTF-8
export EDITOR=nvim VISUAL=nvim

# Homebrew initialization (explicit prefix, then Apple Silicon).
() {
	local brew initialization
	for brew in "${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/bin/brew}" /opt/homebrew/bin/brew; do
		[[ -x $brew ]] || continue
		if initialization=$(command "$brew" shellenv zsh); then
			eval "$initialization" || print -ru2 -- 'zsh: Homebrew initialization failed'
		else
			print -ru2 -- 'zsh: could not generate Homebrew environment'
		fi
		break
	done
}

# Prefer standalone mise and other user-local executables over Homebrew.
[[ -d $HOME/.local/bin ]] && path=("$HOME/.local/bin" $path)

# Prepend mise shims after Homebrew for login shells without interactive hooks.
# Ordinary `ssh host command` does not load this profile; use an explicit login
# shell or mise exec when automation needs that environment.
[[ -d "${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims" ]] && \
	path=("${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims" $path)

# Optional Mint-installed tools; enable with spm:yonaskolb/Mint in
# mise/configuration.toml. Mise supplies the mint executable itself.
# [[ -d $HOME/.mint/bin ]] && path+=("$HOME/.mint/bin")

# Rust/Cargo binaries
[[ -d $HOME/.cargo/bin ]] && path+=("$HOME/.cargo/bin")

# JetBrains Toolbox initialization
[[ -d "$HOME/Library/Application Support/JetBrains/Toolbox/scripts" ]] && path+=("$HOME/Library/Application Support/JetBrains/Toolbox/scripts")

# Kotlin Multiplatform initialization
[[ -d "$HOME/Library/Android/sdk" ]] && export ANDROID_HOME="$HOME/Library/Android/sdk"
