#!/bin/zsh

### User's environment variables ###

# XDG_CONFIG_HOME must be supplied before startup, as it is when running setup.
# Linked in both HOME and ZDOTDIR so child shells also read these exports.
export ZDOTDIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"

# Use XDG directories for GHCup installation and subsequent commands.
export GHCUP_USE_XDG_DIRS=true
