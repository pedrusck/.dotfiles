### Interactive Zsh configuration ###

[[ -o interactive ]] || return

if [[ -n $ZSHRC_DEBUG ]]; then
	zmodload zsh/zprof
	zmodload zsh/datetime
	typeset -gF _ZSHRC_START=$EPOCHREALTIME
fi

## Shell options and history

setopt EXTENDED_GLOB
typeset -U path fpath
_zsh_config_dir=${ZDOTDIR:-${XDG_CONFIG_HOME:-$HOME/.config}/zsh}

HISTFILE=$_zsh_config_dir/.zsh_history
HISTSIZE=2000
SAVEHIST=1000

## Environment and paths

# Make standalone mise available in non-login shells before activation.
[[ -d $HOME/.local/bin ]] && path=("$HOME/.local/bin" $path)

# Shims make tools available before the mise activation block below, including
# for aliases and Zoxide initialization in non-login shells.
[[ -d "${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims" ]] && \
	path=("${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims" $path)

# SourceKit-LSP fallback: select DEVELOPER_DIR before xcode-select, but retain
# earlier executables on PATH rather than overriding the whole toolchain.
() {
	local developer_dir=$DEVELOPER_DIR
	local sourcekit_bin

	if [[ -z $developer_dir ]] && (( $+commands[xcode-select] )); then
		developer_dir=$(command xcode-select -p 2>/dev/null) || developer_dir=''
	fi
	[[ $developer_dir == *.app ]] && developer_dir+=/Contents/Developer
	sourcekit_bin="$developer_dir/Toolchains/XcodeDefault.xctoolchain/usr/bin"
	[[ -n $developer_dir && -d $sourcekit_bin ]] && path+=("$sourcekit_bin")
}

# Secretive: prefer its socket when available; otherwise retain the native agent.
() {
	local socket="$HOME/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
	[[ -S $socket ]] && export SSH_AUTH_SOCK="$socket"
}

# Custom functions; tool completion paths are added before compinit below.
[[ -d $_zsh_config_dir/zsh_functions ]] && fpath=("$_zsh_config_dir/zsh_functions" $fpath)

## Aliases

# Navigation:
alias ..='cd ..'
alias desktop='cd "$HOME/Desktop"'
alias downloads='cd "$HOME/Downloads"'
alias derived_data='cd "$HOME/Library/Developer/Xcode/DerivedData"'

# Listing: ll includes hidden files, lll adds a tree, d sorts newest first.
if (( $+commands[eza] )); then
	() {
		local list='eza -l --git --group-directories-first --icons --no-user'
		alias l="$list"
		alias ld="$list --sort=modified -r"
		alias ll="$list -a"
		alias lld="$list -a --sort=modified -r"
		alias lll="$list -aT --level=3"
		alias llld="$list -aT --level=3 --sort=modified -r"
	}
else
	alias l='ls -FGhl'
	alias ld='ls -FGhlt'
	alias ll='ls -aFGhl'
	alias lld='ls -aFGhlt'
fi

# Applications
(( $+commands[lazygit] )) && alias lg='lazygit'
(( $+commands[spotify_player] )) && alias spotify='spotify_player'
(( $+commands[leaf] )) && alias -s md='leaf'

# Herdr sessions (see herdr/keybindings.md).
if (( $+commands[herdr] )); then
	alias hh='herdr'
	alias ha='herdr session attach'
	alias hl='herdr session list'
	alias hs='herdr status'
	alias hk='herdr server stop' # Stops all panes.
fi

## Custom functions and scripts

# Explicit allowlist: this directory also contains standalone scripts.
autoload -Uz \
	audio_fix_crackling_noise \
	git_change_author git_change_timestamp git_clone_worktrees git_multiple_pull \
	gpg_copy_key gpg_export_key gpg_import_key \
	latex_update opencode_update_provider_models ssh_add_identities \
	teams_clean_cache xcode_projects_list xcode_remove_derived_data

## Completions

() {
	# Completions for tools still managed by Homebrew.
	local brew_completions=${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh/site-functions
	[[ -d $brew_completions ]] && fpath=("$brew_completions" $fpath)
	# mise/setup.sh and mise's postinstall hook generate these files.
	local completion_dir=${MISE_COMPLETIONS_SYNC_ZSH_DIR:-${MISE_COMPLETIONS_SYNC_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/mise-completions}/zsh}
	[[ -d $completion_dir ]] && fpath=("$completion_dir" $fpath)
}

# Progressive matching: exact, smart case, word-flex, then full-flex.
zstyle ':completion:*' matcher-list '' \
	'm:{a-z\-}={A-Z\_}' \
	'r:[^[:alpha:]]||[[:alpha:]]=** r:|=* m:{a-z\-}={A-Z\_}' \
	'r:|?=** m:{a-z\-}={A-Z\_}'

() {
	autoload -Uz compinit
	local cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
	local dump="$cache_dir/zcompdump-$ZSH_VERSION"

	if ! { [[ -d $cache_dir ]] || command mkdir -p -- "$cache_dir"; } || [[ ! -w $cache_dir ]]; then
		compinit -i -D
		return
	fi
	# Audit on each startup; -i excludes insecure directories without prompting.
	compinit -i -d "$dump"
}

## Fuzzy finders

() {
	# Shared preview: placeholders are shell-quoted by fzf/Skim.
	local preview='
		if [ -d {} ]; then
			if command -v tree >/dev/null 2>&1; then
				tree -C -L 2 -- {}
			else
				ls -la -- {}
			fi
		elif [ -f {} ]; then
			if file --brief --mime-encoding -- {} | grep -qx binary; then
				file -- {}
			elif command -v bat >/dev/null 2>&1; then
				bat --style=numbers --color=always --line-range=:500 -- {}
			else
				head -n 500 -- {}
			fi
		fi
	'
	local common="
		--bind=ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down
		--color=gutter:-1,selected-bg:238
		--highlight-line
		--multi
		--prompt='▌ '
	"

	# fzf: previews apply to file/directory pickers, not history or arbitrary lists.
	export FZF_DEFAULT_OPTS="
		$common
		--marker=▏
		--pointer=▌
	"
	export FZF_CTRL_T_OPTS="--preview \"$preview\""
	export FZF_ALT_C_OPTS="--preview \"$preview\""
	export FZF_COMPLETION_PATH_OPTS="--preview \"$preview\""
	export FZF_COMPLETION_DIR_OPTS="--preview \"$preview\""

	# Skim
	export SKIM_DEFAULT_OPTIONS="
		$common
		--multi-selector=▏
		--selector=▌
		--preview \"$preview\"
	"
}

## Tool initialization

# For the known integrations below: evaluate successful output in function scope,
# without routing arguments. Generated persistent declarations must be global.
function _zsh_eval_init() {
	local _init_tool=$1 _init_code
	_init_code=$(command "$@") || {
		print -ru2 -- "zsh: could not generate $_init_tool initialization"
		return 1
	}
	set --
	eval "$_init_code" || {
		print -ru2 -- "zsh: $_init_tool initialization failed"
		return 1
	}
}

# zoxide: use builtin cd to bypass its matching behavior.
if (( $+commands[zoxide] )); then
	_zsh_eval_init zoxide init zsh --cmd cd
fi

# Activation initializes the tool environment immediately, including in `zsh -ic`.
# Prompt and directory-change hooks refresh it afterward.
if (( $+commands[mise] )); then
	_zsh_eval_init mise activate zsh
fi

# cplt
if (( $+commands[cplt] )); then
	eval "$(cplt --shell-setup --agent opencode)"
fi

## Prompt

# Starship
export STARSHIP_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/starship/starship.toml"
if (( $+commands[starship] )) && [[ $TERM_PROGRAM != Apple_Terminal ]]; then
	_zsh_eval_init starship init zsh
fi

## Plugins

# Usage: _zsh_source_plugin plugin_name plugin_path
# Missing plugins are quiet; a broken plugin is reported.
function _zsh_source_plugin() {
	local _source_plugin=$1 _source_path=$2
	# Sourced code should not inherit this helper's routing arguments.
	set --
	[[ -f $_source_path && -r $_source_path ]] || return 0
	if source "$_source_path"; then
		return 0
	fi
	print -ru2 -- "zsh: plugin $_source_plugin failed to load: $_source_path"
	return 1
}

# vi-mode settings and hooks must be defined before the plugin is sourced.
function zvm_config() {
	ZVM_LINE_INIT_MODE=$ZVM_MODE_INSERT
	ZVM_SYSTEM_CLIPBOARD_ENABLED=true
}

function _zsh_load_fzf_keybindings() {
	# The executable ships both completion and keybindings, including in mise's
	# binary-only install. Load after vi-mode has initialized its keymaps.
	if (( $+commands[fzf] )); then
		_zsh_eval_init fzf --zsh
	fi
}

function _zsh_bind_keys() {
	local keymap
	for keymap in emacs viins; do
		(( ${+widgets[autosuggest-accept]} )) && bindkey -M "$keymap" '^y' autosuggest-accept
		bindkey -M "$keymap" '^k' history-search-backward
		bindkey -M "$keymap" '^j' history-search-forward
	done
	if (( ${+widgets[fzf-cd-widget]} )); then
		for keymap in emacs viins vicmd; do
			bindkey -M "$keymap" '^g' fzf-cd-widget
			# EurKEY needs Option: remove Alt-C only while it belongs to fzf.
			[[ $(bindkey -M "$keymap" '\ec') == *' fzf-cd-widget' ]] &&
				bindkey -M "$keymap" -r '\ec'
		done
	fi
	return 0
}

function zvm_after_init() {
	_zsh_load_fzf_keybindings
	_zsh_bind_keys
}

# vi-mode installs normal-mode bindings lazily on the first Escape.
function zvm_after_lazy_keybindings() {
	_zsh_bind_keys
}

# Autosuggestions: contextual history first, before ordinary history masks it.
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=242'
ZSH_AUTOSUGGEST_STRATEGY=(match_prev_cmd history completion)

# Homebrew provides the shell plugins.
_zsh_vi_mode_loaded=0
if [[ -t 0 ]]; then
	if _zsh_source_plugin vi_mode \
		"${HOMEBREW_PREFIX:-/opt/homebrew}/opt/zsh-vi-mode/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh" &&
		(( ${+functions[zvm_init]} )) && [[ $ZVM_INIT_DONE == (true|false) ]]; then
		_zsh_vi_mode_loaded=1
	else
		# A failed source may have registered a partially defined deferred hook.
		precmd_functions=(${precmd_functions:#zvm_init})
	fi

	# With vi-mode, zvm_after_init loads bindings after its deferred keymap reset.
	if (( ! _zsh_vi_mode_loaded )) || [[ $ZVM_INIT_DONE == true ]]; then
		_zsh_load_fzf_keybindings
	fi
fi

_zsh_source_plugin autosuggestions \
	"${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# Keep highlighting last for compatibility with older Zsh widget wrappers.
_zsh_source_plugin syntax_highlighting \
	"${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

if [[ -t 0 ]] && { (( ! _zsh_vi_mode_loaded )) || [[ $ZVM_INIT_DONE == true ]]; }; then
	_zsh_bind_keys
fi
unset _zsh_vi_mode_loaded

## Local configuration

_zsh_overrides=$_zsh_config_dir/zsh_additional_configuration

[[ -f $_zsh_overrides/zsh_additional_aliases.secret.zsh && -r $_zsh_overrides/zsh_additional_aliases.secret.zsh ]] &&
	source "$_zsh_overrides/zsh_additional_aliases.secret.zsh"

[[ -f $_zsh_overrides/zsh_company_configuration.secret.zsh && -r $_zsh_overrides/zsh_company_configuration.secret.zsh ]] &&
	source "$_zsh_overrides/zsh_company_configuration.secret.zsh"

unset _zsh_overrides _zsh_config_dir

## Profiling end

if [[ -n $ZSHRC_DEBUG ]]; then
	printf 'zshrc configuration: %.1f ms (excludes first-prompt hooks/rendering)\n' \
		"$((1000 * (EPOCHREALTIME - _ZSHRC_START)))" >&2
	unset _ZSHRC_START
	zprof
fi
